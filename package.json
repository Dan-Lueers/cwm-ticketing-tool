{
  "name": "ticketing-tool",
  "private": true,
  "workspaces": ["client", "server", "e2e"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "build": "bun --filter client build",
    "test": "bun --filter server test",
    "test:e2e": "bun --filter e2e test",
    "typecheck": "bun --filter server typecheck && bun --filter e2e typecheck && bun --filter client build",
    "lint": "bun --filter client lint"
  }
}
