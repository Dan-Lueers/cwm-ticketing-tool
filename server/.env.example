# Local PostgreSQL. Replace the user (and add :password if your server needs one).
DATABASE_URL="postgresql://USER@localhost:5432/ticketing-tool"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the server (in development, the Express server).
BETTER_AUTH_URL="http://localhost:3000"

# Admin created (or promoted to admin) by `bun run db:seed`. The seed never changes an existing password.
# password123 is for local development only: set a strong password in any deployed environment.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="password123"
