# Local PostgreSQL. Replace the user (and add :password if your server needs one).
DATABASE_URL="postgresql://USER@localhost:5432/ticketing-tool"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the server (in development, the Express server).
BETTER_AUTH_URL="http://localhost:3000"

# First user, created by `bun run db:seed` if no user with this email exists yet.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
