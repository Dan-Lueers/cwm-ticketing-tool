# End-to-end test environment. Copy to .env. Playwright loads it (playwright.config.ts) and passes it to the
# test server; server/.env is never read during end-to-end tests.

# A separate database, dropped and rebuilt from the migrations on every run. Its name must end in "-test".
DATABASE_URL="postgresql://USER@localhost:5432/ticketing-tool-test"

# Any random value (openssl rand -base64 32); not the development secret.
BETTER_AUTH_SECRET=""

# Admin created by the seed in the test database.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="e2e-admin-password"

# Agent created in the test database, for checking what non-admins can't do.
AGENT_EMAIL="agent@example.com"
AGENT_PASSWORD="e2e-agent-password"
